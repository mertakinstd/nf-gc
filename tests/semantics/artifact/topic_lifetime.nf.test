nextflow_pipeline {

    name "nf-gc artifact topic semantics"
    script "tests/semantics/topic_lifetime.nf"
    config "tests/config/gc_mode_artifact.config"

    test("does not treat a topic file as terminal before its topic demand completes") {
        when {
            params { publish_dir = "$launchDir/published" }
        }
        then {
            assert workflow.success
            assert workflow.trace.failed().size() == 0
            def events = path("$launchDir/nf-gc-events.tsv").readLines()

            def sourceComplete = events.findIndexOf { line ->
                def f = line.split('\t', 5)
                f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'TOPIC_SOURCE'
            }
            def consumerComplete = events.findIndexOf { line ->
                def f = line.split('\t', 5)
                f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'TOPIC_CONSUMER'
            }
            assert sourceComplete >= 0
            assert consumerComplete > sourceComplete

            def sourceLine = events[sourceComplete]
            def artifact = java.nio.file.Path.of(sourceLine.split('\t', 5)[4]).resolve('topic.txt')
            def deleted = events.findIndexOf { it == "ARTIFACT_DELETED\tTOPIC_SOURCE\t${artifact}" }
            def flowComplete = events.findIndexOf { it == 'FLOW_COMPLETE' }

            assert deleted > consumerComplete
            assert flowComplete > deleted
            assert !java.nio.file.Files.exists(artifact, java.nio.file.LinkOption.NOFOLLOW_LINKS)
            assert path("$launchDir/published/topic.done").text == 'topic-payload\n'
        }
    }
}
