            def firstSample = consumerCompletions.keySet().min { consumerCompletions[it] }
            def laterSample = consumerCompletions.keySet().find { it != firstSample }
            assert consumerCompletions[firstSample] < consumerCompletions[laterSample]
            assert deletionIndexes[firstSample] < consumerCompletions[laterSample]
