nextflow_pipeline {

    name "nf-gc artifact semantics"
    script "tests/semantics/model.nf"
    config "tests/config/gc_mode_artifact.config"

    test("reclaims one-to-one artifacts after their concrete consumer task completes") {
        when {
            params { publish_dir = "$launchDir/published" }
        }
        then {
            assert workflow.success
            assert workflow.trace.failed().size() == 0
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            assert events.count { it == 'GC_MODE\tartifact' } == 1

            def consumerCompletions = [:]
            def deletionIndexes = [:]

            ['one', 'two'].each { sample ->
                def sourceComplete = events.find { line ->
                    def f = line.split('\t', 5)
                    f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'LINEAR_SOURCE' && f[3].contains("(${sample})")
                }
                def consumerComplete = events.findIndexOf { line ->
                    def f = line.split('\t', 5)
                    f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'LINEAR_CONSUMER' && f[3].contains("(${sample})")
                }
                assert sourceComplete != null
                assert consumerComplete >= 0
                def artifact = java.nio.file.Path.of(sourceComplete.split('\t', 5)[4]).resolve("${sample}.linear.txt")
                def deleted = events.findIndexOf { it == "ARTIFACT_DELETED\tLINEAR_SOURCE\t${artifact}" }
                assert deleted > consumerComplete
                assert !java.nio.file.Files.exists(artifact, java.nio.file.LinkOption.NOFOLLOW_LINKS)
                consumerCompletions[sample] = consumerComplete
                deletionIndexes[sample] = deleted
            }

            def firstSample = consumerCompletions.keySet().min { consumerCompletions[it] }
            def laterSample = consumerCompletions.keySet().find { it != firstSample }
            assert consumerCompletions[firstSample] < consumerCompletions[laterSample]
            assert deletionIndexes[firstSample] < consumerCompletions[laterSample]
        }
    }

    test("reclaims an output port independently of a slow sibling port") {
        when {
            params { publish_dir = "$launchDir/published" }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()

            def sourceComplete = events.find { line ->
                def f = line.split('\t', 5)
                f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'SIBLING_SOURCE'
            }
            assert sourceComplete != null
            def workDir = java.nio.file.Path.of(sourceComplete.split('\t', 5)[4])
            def fast = workDir.resolve('sibling-fast.txt')
            def slow = workDir.resolve('sibling-slow.txt')
            def fastComplete = events.findIndexOf { line ->
                def f = line.split('\t', 5)
                f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'SIBLING_FAST'
            }
            def slowComplete = events.findIndexOf { line ->
                def f = line.split('\t', 5)
                f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'SIBLING_SLOW'
            }
            def fastDeleted = events.findIndexOf { it == "ARTIFACT_DELETED\tSIBLING_SOURCE\t${fast}" }
            def slowDeleted = events.findIndexOf { it == "ARTIFACT_DELETED\tSIBLING_SOURCE\t${slow}" }

            assert fastComplete >= 0
            assert slowComplete > fastComplete
            assert fastDeleted > fastComplete
            assert fastDeleted < slowComplete
            assert slowDeleted > slowComplete
            assert !java.nio.file.Files.exists(fast, java.nio.file.LinkOption.NOFOLLOW_LINKS)
            assert !java.nio.file.Files.exists(slow, java.nio.file.LinkOption.NOFOLLOW_LINKS)
        }
    }

    test("reclaims a fan-out artifact only after its concrete consumers complete") {
        when {
            params { publish_dir = "$launchDir/published" }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()

            def eligibleAfter = [:]
            def deletionIndexes = [:]

            ['one', 'two'].each { sample ->
                def sourceComplete = events.find { line ->
                    def f = line.split('\t', 5)
                    f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'FANOUT_SOURCE' && f[3].contains("(${sample})")
                }
                def leftComplete = events.findIndexOf { line ->
                    def f = line.split('\t', 5)
                    f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'FANOUT_LEFT' && f[3].contains("(${sample})")
                }
                def rightComplete = events.findIndexOf { line ->
                    def f = line.split('\t', 5)
                    f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'FANOUT_RIGHT' && f[3].contains("(${sample})")
                }
                assert sourceComplete != null
                assert leftComplete >= 0
                assert rightComplete >= 0
                def artifact = java.nio.file.Path.of(sourceComplete.split('\t', 5)[4]).resolve("${sample}.fanout.txt")
                def deleted = events.findIndexOf { it == "ARTIFACT_DELETED\tFANOUT_SOURCE\t${artifact}" }
                def ready = Math.max(leftComplete, rightComplete)
                assert deleted > ready
                assert !java.nio.file.Files.exists(artifact, java.nio.file.LinkOption.NOFOLLOW_LINKS)
                eligibleAfter[sample] = ready
                deletionIndexes[sample] = deleted
            }

            def firstSample = eligibleAfter.keySet().min { eligibleAfter[it] }
            def laterSample = eligibleAfter.keySet().find { it != firstSample }
            assert eligibleAfter[firstSample] < eligibleAfter[laterSample]
            assert deletionIndexes[firstSample] < eligibleAfter[laterSample]
        }
    }

