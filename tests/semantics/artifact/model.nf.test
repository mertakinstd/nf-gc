    test("does not reclaim a shared singleton before its last concrete consumer completes") {
        when {
            params { publish_dir = "$launchDir/published" }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()

            def sourceComplete = events.find { line ->
                def f = line.split('\t', 5)
                f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'SHARED_INDEX'
            }
            assert sourceComplete != null
            def artifact = java.nio.file.Path.of(sourceComplete.split('\t', 5)[4]).resolve('shared.index')
            def deletion = events.findIndexOf { it == "ARTIFACT_DELETED\tSHARED_INDEX\t${artifact}" }
            assert deletion >= 0

            def completions = []
            events.eachWithIndex { line, index ->
                def f = line.split('\t', 5)
                if( f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'INDEX_CONSUMER' )
                    completions << index
            }
            assert completions.size() == 3
            assert deletion > completions.max()
            assert !java.nio.file.Files.exists(artifact, java.nio.file.LinkOption.NOFOLLOW_LINKS)
        }
    }

    test("does not reclaim collected artifacts before the aggregate consumer completes") {
        when {
            params { publish_dir = "$launchDir/published" }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()

            def consumerComplete = events.findIndexOf { line ->
                def f = line.split('\t', 5)
                f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'COLLECT_CONSUMER'
            }
            assert consumerComplete >= 0

            ['one', 'two', 'three'].each { sample ->
                def sourceComplete = events.find { line ->
                    def f = line.split('\t', 5)
                    f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'COLLECT_SOURCE' && f[3].contains("(${sample})")
                }
                assert sourceComplete != null
                def artifact = java.nio.file.Path.of(sourceComplete.split('\t', 5)[4]).resolve("${sample}.collect.txt")
                def deleted = events.findIndexOf { it == "ARTIFACT_DELETED\tCOLLECT_SOURCE\t${artifact}" }
                assert deleted > consumerComplete
                assert !java.nio.file.Files.exists(artifact, java.nio.file.LinkOption.NOFOLLOW_LINKS)
            }
        }
    }

    test("does not reclaim a joined artifact before its keyed consumer completes") {
        when {
            params { publish_dir = "$launchDir/published" }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()

            def leftComplete = events.findIndexOf { line ->
                def f = line.split('\t', 5)
                f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'JOIN_LEFT_SOURCE' && f[3].contains('(late)')
            }
            def consumerComplete = events.findIndexOf { line ->
                def f = line.split('\t', 5)
                f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'JOIN_CONSUMER' && f[3].contains('(late)')
            }
            assert leftComplete >= 0
            assert consumerComplete >= 0

            def artifact = java.nio.file.Path.of(events[leftComplete].split('\t', 5)[4]).resolve('late.left.txt')
            def deleted = events.findIndexOf { it == "ARTIFACT_DELETED\tJOIN_LEFT_SOURCE\t${artifact}" }
            assert deleted > consumerComplete
            assert !java.nio.file.Files.exists(artifact, java.nio.file.LinkOption.NOFOLLOW_LINKS)
        }
    }

    test("reclaims a conditionally routed artifact after only its concrete branch completes") {
        when {
            params { publish_dir = "$launchDir/published" }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()

            def leftSource = events.find { line ->
                def f = line.split('\t', 5)
                f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'ROUTED_SOURCE' && f[3].contains('(left)')
            }
            def rightSource = events.find { line ->
                def f = line.split('\t', 5)
                f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'ROUTED_SOURCE' && f[3].contains('(right)')
            }
            def leftComplete = events.findIndexOf { line ->
                def f = line.split('\t', 5)
                f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'ROUTED_LEFT'
            }
            def rightComplete = events.findIndexOf { line ->
                def f = line.split('\t', 5)
                f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'ROUTED_RIGHT'
            }

            assert leftSource != null
            assert rightSource != null
            assert events.count { line ->
                def f = line.split('\t', 5)
                f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'ROUTED_LEFT'
            } == 1
            assert events.count { line ->
                def f = line.split('\t', 5)
                f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'ROUTED_RIGHT'
            } == 1
            assert leftComplete >= 0
            assert rightComplete > leftComplete

            def leftArtifact = java.nio.file.Path.of(leftSource.split('\t', 5)[4]).resolve('left.routed.txt')
            def rightArtifact = java.nio.file.Path.of(rightSource.split('\t', 5)[4]).resolve('right.routed.txt')
            def leftDeleted = events.findIndexOf { it == "ARTIFACT_DELETED\tROUTED_SOURCE\t${leftArtifact}" }
            def rightDeleted = events.findIndexOf { it == "ARTIFACT_DELETED\tROUTED_SOURCE\t${rightArtifact}" }

            assert leftDeleted > leftComplete
            assert leftDeleted < rightComplete
            assert rightDeleted > rightComplete
            assert !java.nio.file.Files.exists(leftArtifact, java.nio.file.LinkOption.NOFOLLOW_LINKS)
            assert !java.nio.file.Files.exists(rightArtifact, java.nio.file.LinkOption.NOFOLLOW_LINKS)
        }
    }

    test("retains the published artifact without pinning its unpublished sibling") {
        when {
            params { publish_dir = "$launchDir/published" }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()

            def sourceComplete = events.find { line ->
                def f = line.split('\t', 5)
                f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'PARTIAL_PUBLISH'
            }
            def consumerComplete = events.findIndexOf { line ->
                def f = line.split('\t', 5)
                f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'EPHEMERAL_CONSUMER'
            }
            assert sourceComplete != null
            assert consumerComplete >= 0
            def workDir = java.nio.file.Path.of(sourceComplete.split('\t', 5)[4])
            def published = workDir.resolve('semantic.published.txt')
            def ephemeral = workDir.resolve('semantic.ephemeral.txt')
            def ephemeralDeleted = events.findIndexOf { it == "ARTIFACT_DELETED\tPARTIAL_PUBLISH\t${ephemeral}" }

            assert events.any { it == "FILE_PUBLISH\t${published}" }
            assert !events.any { it == "ARTIFACT_DELETED\tPARTIAL_PUBLISH\t${published}" }
            assert ephemeralDeleted > consumerComplete
            assert java.nio.file.Files.exists(published, java.nio.file.LinkOption.NOFOLLOW_LINKS)
            assert !java.nio.file.Files.exists(ephemeral, java.nio.file.LinkOption.NOFOLLOW_LINKS)
            assert path("$launchDir/published/semantic.published.txt").exists()
            assert !path("$launchDir/published/semantic.ephemeral.txt").exists()
        }
    }
}
