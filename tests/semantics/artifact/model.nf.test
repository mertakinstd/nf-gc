    test("reclaims an unused declared output at producer-task granularity") {
        when {
            params { publish_dir = "$launchDir/published" }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()

            def producerCompletions = [:]
            def deletionIndexes = [:]

            ['one', 'two'].each { sample ->
                def completed = events.findIndexOf { line ->
                    def f = line.split('\t', 5)
                    f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'UNUSED_SOURCE' && f[3].contains("(${sample})")
                }
                assert completed >= 0
                def completionLine = events[completed]
                def artifact = java.nio.file.Path.of(completionLine.split('\t', 5)[4]).resolve("${sample}.unused.txt")
                def deleted = events.findIndexOf { it == "ARTIFACT_DELETED\tUNUSED_SOURCE\t${artifact}" }
                assert deleted > completed
                assert !java.nio.file.Files.exists(artifact, java.nio.file.LinkOption.NOFOLLOW_LINKS)
                producerCompletions[sample] = completed
                deletionIndexes[sample] = deleted
            }

            def firstSample = producerCompletions.keySet().min { producerCompletions[it] }
            def laterSample = producerCompletions.keySet().find { it != firstSample }
            assert producerCompletions[firstSample] < producerCompletions[laterSample]
            assert deletionIndexes[firstSample] < producerCompletions[laterSample]
        }
    }

