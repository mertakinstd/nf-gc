    test("reclaims a declared directory without cleaning unrelated task files") {
        when {
            params {
                scenario = 'directory_output'
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            def tracked = events.findAll { it.startsWith('ARTIFACT_TRACKED\tDIRECTORY_OUTPUT_SOURCE\t') }
            def deleted = events.findAll { it.startsWith('ARTIFACT_DELETED\tDIRECTORY_OUTPUT_SOURCE\t') }
            assert tracked.size() == 1
            assert deleted.size() == 1

            def directory = path(deleted.first().split('\t', 3)[2])
            def workDir = directory.parent
            assert directory.fileName.toString() == 'index'
            assert !java.nio.file.Files.exists(directory, java.nio.file.LinkOption.NOFOLLOW_LINKS)
            assert java.nio.file.Files.exists(workDir.resolve('tool.log'))
            assert java.nio.file.Files.exists(workDir.resolve('.command.sh'))
            assert java.nio.file.Files.exists(workDir.resolve('.command.run'))
        }
    }

    test("keeps a staged external input while reclaiming multiple generated outputs") {
        when {
            params {
                scenario = 'staged_multi_output'
                external_path = "$launchDir/external/source.txt"
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            def tracked = events.findAll { it.startsWith('ARTIFACT_TRACKED\tSTAGED_MULTI_SOURCE\t') }
            def deleted = events.findAll { it.startsWith('ARTIFACT_DELETED\tSTAGED_MULTI_SOURCE\t') }
            assert path(params.external_path).exists()
            assert path(params.external_path).text == 'external-data\n'
            assert tracked.size() == 2
            assert deleted.size() == 2
            assert (deleted.collect { path(it.split('\t', 3)[2]).fileName.toString() } as Set) == (['sample.bam', 'sample.bai'] as Set)
            assert !events.any { it.startsWith('ARTIFACT_DELETED\tSTAGED_MULTI_SOURCE\t') && it.endsWith('/source.txt') }
        }
    }


    test("falls back when an operator erases concrete Path provenance") {
        config "tests/config/gc_mode_artifact.config"

        when {
            params {
                scenario = 'opaque_path_alias'
            }
        }
        then {
            assert workflow.success
            assert workflow.trace.failed().size() == 0

            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            def sourceComplete = events.find { line ->
                def f = line.split('\t', 5)
                f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'OPAQUE_ALIAS_SOURCE'
            }
            assert sourceComplete != null

            def source = java.nio.file.Path.of(sourceComplete.split('\t', 5)[4]).resolve('opaque-source.txt')
            def consumerTerminated = events.findIndexOf { it == 'PROCESS_TERMINATE\tOPAQUE_ALIAS_CONSUMER' }
            def deleted = events.findIndexOf { it == "ARTIFACT_DELETED\tOPAQUE_ALIAS_SOURCE\t${source}" }

            assert consumerTerminated >= 0
            assert deleted > consumerTerminated
            assert !java.nio.file.Files.exists(source, java.nio.file.LinkOption.NOFOLLOW_LINKS)
        }
    }

    test("holds an exact terminal pass-through source until relay process closure in process mode") {
        when {
            params {
                scenario = 'passthrough_terminal_ownership'
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            def sourceComplete = events.find { line ->
                def f = line.split('\t', 5)
                f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'GENERATED_SOURCE'
            }
            assert sourceComplete != null
            def source = java.nio.file.Path.of(sourceComplete.split('\t', 5)[4]).resolve('source.txt')
            def relayTerminated = events.findIndexOf { it == 'PROCESS_TERMINATE\tPASSTHROUGH_DEFAULT' }
            def relayClosed = events.findIndexOf { it == 'DEPENDENCY_CLOSED\tPASSTHROUGH_DEFAULT' }
            def deleted = events.findIndexOf { it == "ARTIFACT_DELETED\tGENERATED_SOURCE\t${source}" }
            def flowComplete = events.findIndexOf { it == 'FLOW_COMPLETE' }
            assert relayTerminated >= 0
            assert relayClosed > relayTerminated
            assert deleted > relayClosed
            assert deleted < flowComplete
            assert !java.nio.file.Files.exists(source, java.nio.file.LinkOption.NOFOLLOW_LINKS)
        }
    }

    test("retains an upstream directory when a relay re-emits only a staged descendant") {
        config "tests/config/gc_mode_artifact.config"

        when {
            params {
                scenario = 'nested_generated_reemit'
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            def sourceComplete = events.find { line ->
                def f = line.split('\t', 5)
                f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'GENERATED_DIRECTORY_SOURCE'
            }
            assert sourceComplete != null

            def bundle = java.nio.file.Path.of(sourceComplete.split('\t', 5)[4]).resolve('bundle')
            assert java.nio.file.Files.exists(bundle.resolve('item.txt'), java.nio.file.LinkOption.NOFOLLOW_LINKS)
            assert java.nio.file.Files.exists(bundle.resolve('extra.txt'), java.nio.file.LinkOption.NOFOLLOW_LINKS)
            assert !events.any { it == "ARTIFACT_DELETED\tGENERATED_DIRECTORY_SOURCE\t${bundle}" }
            assert events.contains('ARTIFACT_KEEP\tNESTED_UPSTREAM_REEMIT\tUNKNOWN')
        }
    }


    test("does not acquire a staged directory descendant as an owned artifact in process mode") {
        when {
            params {
                scenario = 'nested_external_reemit'
                external_path = "$launchDir/external/bundle"
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            def externalItem = path("${params.external_path}/item.txt")
            assert externalItem.exists()
            assert externalItem.text == 'external-nested\n'
            assert !events.any { it.startsWith('ARTIFACT_TRACKED\tNESTED_EXTERNAL_REEMIT\t') }
            assert !events.any { it.startsWith('ARTIFACT_DELETED\tNESTED_EXTERNAL_REEMIT\t') }
        }
    }

    test("does not acquire a staged directory descendant as an owned artifact in artifact mode") {
        config "tests/config/gc_mode_artifact.config"

        when {
            params {
                scenario = 'nested_external_reemit'
                external_path = "$launchDir/external/bundle"
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            def externalItem = path("${params.external_path}/item.txt")
            assert externalItem.exists()
            assert externalItem.text == 'external-nested\n'
            assert !events.any { it.startsWith('ARTIFACT_TRACKED\tNESTED_EXTERNAL_REEMIT\t') }
            assert !events.any { it.startsWith('ARTIFACT_DELETED\tNESTED_EXTERNAL_REEMIT\t') }
            assert events.contains('ARTIFACT_KEEP\tNESTED_EXTERNAL_REEMIT\tUNKNOWN')
        }
    }

}
