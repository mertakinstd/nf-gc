nextflow_pipeline {

    name "nf-gc ownership regression matrix"
    script "tests/regression/ownership.nf"

    test("keeps an external input with default staging and deletes only generated output") {
        when {
            params {
                scenario = 'external_default'
                external_path = "$launchDir/external/source.txt"
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            assert path(params.external_path).exists()
            assert path(params.external_path).text == 'external-data\n'
            assert events.count { it.startsWith('ARTIFACT_TRACKED\tCOPY_EXTERNAL_DEFAULT\t') } == 1
            def deleted = events.find { it.startsWith('ARTIFACT_DELETED\tCOPY_EXTERNAL_DEFAULT\t') }
            assert deleted != null
            assert !java.nio.file.Files.exists(path(deleted.split('\t', 3)[2]), java.nio.file.LinkOption.NOFOLLOW_LINKS)
            assert !events.any { it.contains("\t${params.external_path}") && it.startsWith('ARTIFACT_DELETED\t') }
        }
    }

    test("keeps an external input when stageInMode is copy") {
        when {
            params {
                scenario = 'external_stage_copy'
                external_path = "$launchDir/external/source.txt"
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            assert path(params.external_path).exists()
            assert path(params.external_path).text == 'external-data\n'
            assert events.count { it.startsWith('ARTIFACT_TRACKED\tCOPY_EXTERNAL_STAGE_COPY\t') } == 1
            def deleted = events.find { it.startsWith('ARTIFACT_DELETED\tCOPY_EXTERNAL_STAGE_COPY\t') }
            assert deleted != null
            assert !java.nio.file.Files.exists(path(deleted.split('\t', 3)[2]), java.nio.file.LinkOption.NOFOLLOW_LINKS)
        }
    }

    test("does not acquire ownership when an external staged input is re-emitted") {
        when {
            params {
                scenario = 'external_reemit'
                external_path = "$launchDir/external/source.txt"
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            assert path(params.external_path).exists()
            assert path(params.external_path).text == 'external-data\n'
            assert !events.any { it.startsWith('ARTIFACT_TRACKED\tPASSTHROUGH_DEFAULT\t') }
            assert !events.any { it.startsWith('ARTIFACT_DELETED\tPASSTHROUGH_DEFAULT\t') }
        }
    }


    test("does not reacquire an upstream artifact re-emitted through default staging") {
        when {
            params {
                scenario = 'passthrough_default_ownership'
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            def sourceComplete = events.find { line ->
                def f = line.split('\t', 5)
                f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'GENERATED_SOURCE'
            }
            assert sourceComplete != null
            def source = java.nio.file.Path.of(sourceComplete.split('\t', 5)[4]).resolve('source.txt')
            assert events.any { it == "ARTIFACT_DELETED\tGENERATED_SOURCE\t${source}" }
            assert !events.any { it.startsWith('ARTIFACT_DELETED\tPASSTHROUGH_DEFAULT\t') }
            assert !java.nio.file.Files.exists(source, java.nio.file.LinkOption.NOFOLLOW_LINKS)
        }
    }


    test("preserves an upstream artifact through a copy-staged pass-through relay until downstream process closure") {
        when {
            params {
                scenario = 'passthrough_stage_copy'
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            def producerClosed = events.findIndexOf { it == 'DEPENDENCY_CLOSED\tGENERATED_SOURCE' }
            def downstreamClosed = events.findIndexOf { it == 'DEPENDENCY_CLOSED\tREAD_LATE' }
            def relayClosed = events.findIndexOf { it == 'DEPENDENCY_CLOSED\tPASSTHROUGH_STAGE_COPY' }
            def deleted = events.findIndexOf { it.startsWith('ARTIFACT_DELETED\tGENERATED_SOURCE\t') }
            assert events.any { it.startsWith('ARTIFACT_TRACKED\tGENERATED_SOURCE\t') }
            assert !events.any { it.startsWith('ARTIFACT_TRACKED\tPASSTHROUGH_STAGE_COPY\t') }
            assert !events.any { it.startsWith('ARTIFACT_DELETED\tPASSTHROUGH_STAGE_COPY\t') }
            assert downstreamClosed > producerClosed
            assert relayClosed >= downstreamClosed
            assert deleted > downstreamClosed
            assert deleted > relayClosed
            def deletedPath = events[deleted].split('\t', 3)[2]
            assert !java.nio.file.Files.exists(path(deletedPath), java.nio.file.LinkOption.NOFOLLOW_LINKS)
        }
    }

    test("deletes a generated symlink without following its external target") {
        when {
            params {
                scenario = 'symlink_output'
                external_path = "$launchDir/external/target.txt"
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            assert path(params.external_path).exists()
            assert path(params.external_path).text == 'external-target\n'
            def deleted = events.find { it.startsWith('ARTIFACT_DELETED\tSYMLINK_OUTPUT\t') }
            assert deleted != null
            assert !java.nio.file.Files.exists(path(deleted.split('\t', 3)[2]), java.nio.file.LinkOption.NOFOLLOW_LINKS)
        }
    }

    test("recursive directory cleanup does not follow an external symlink") {
        when {
            params {
                scenario = 'directory_symlink'
                external_path = "$launchDir/external/target.txt"
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            assert path(params.external_path).exists()
            assert path(params.external_path).text == 'external-target\n'
            def deleted = events.find { it.startsWith('ARTIFACT_DELETED\tDIRECTORY_WITH_EXTERNAL_SYMLINK\t') }
            assert deleted != null
            assert !java.nio.file.Files.exists(path(deleted.split('\t', 3)[2]), java.nio.file.LinkOption.NOFOLLOW_LINKS)
            assert !events.any { it.startsWith('ARTIFACT_DELETE_FAILED\t') }
        }
    }

    test("does not acquire a declared descendant reached through a task-created symlink in process mode") {
        when {
            params {
                scenario = 'symlink_ancestor_descendant'
                external_path = "$launchDir/external/symlink-tree"
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            def externalItem = path("${params.external_path}/item.txt")
            assert externalItem.exists()
            assert externalItem.text == 'external-symlink-descendant\n'
            assert !events.any { it.startsWith('ARTIFACT_TRACKED\tSYMLINK_ANCESTOR_DESCENDANT\t') && it.endsWith('/alias/item.txt') }
            assert !events.any { it.startsWith('ARTIFACT_DELETED\tSYMLINK_ANCESTOR_DESCENDANT\t') && it.endsWith('/alias/item.txt') }
            assert events.any { it.startsWith('ARTIFACT_DELETED\tSYMLINK_ANCESTOR_DESCENDANT\t') && it.endsWith('/independent.txt') }
        }
    }

    test("does not acquire a declared descendant reached through a task-created symlink in artifact mode") {
        config "tests/config/gc_mode_artifact.config"

        when {
            params {
                scenario = 'symlink_ancestor_descendant'
                external_path = "$launchDir/external/symlink-tree"
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            def externalItem = path("${params.external_path}/item.txt")
            assert externalItem.exists()
            assert externalItem.text == 'external-symlink-descendant\n'
            assert events.contains('ARTIFACT_KEEP\tSYMLINK_ANCESTOR_DESCENDANT\tUNKNOWN')
            assert !events.any { it.startsWith('ARTIFACT_TRACKED\tSYMLINK_ANCESTOR_DESCENDANT\t') && it.endsWith('/alias/item.txt') }
            assert !events.any { it.startsWith('ARTIFACT_DELETED\tSYMLINK_ANCESTOR_DESCENDANT\t') && it.endsWith('/alias/item.txt') }
            assert events.any { it.startsWith('ARTIFACT_DELETED\tSYMLINK_ANCESTOR_DESCENDANT\t') && it.endsWith('/independent.txt') }
        }
    }

    test("tracks every realized file in a glob output") {
        when {
            params {
                scenario = 'glob_outputs'
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            assert events.count { it.startsWith('ARTIFACT_TRACKED\tGLOB_SOURCE\t') } == 2
            def deleted = events.findAll { it.startsWith('ARTIFACT_DELETED\tGLOB_SOURCE\t') }
            assert deleted.size() == 2
            deleted.each { event ->
                assert !java.nio.file.Files.exists(path(event.split('\t', 3)[2]), java.nio.file.LinkOption.NOFOLLOW_LINKS)
            }
            assert !events.any { it.startsWith('ARTIFACT_MISSING\tGLOB_SOURCE\t') }
        }
    }

    test("does not invent a missing artifact for an absent optional output") {
        when {
            params {
                scenario = 'optional_absent'
                emit_optional = false
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            assert events.count { it.startsWith('ARTIFACT_TRACKED\tOPTIONAL_SOURCE\t') } == 1
            def deleted = events.find { it.startsWith('ARTIFACT_DELETED\tOPTIONAL_SOURCE\t') }
            assert deleted != null
            assert !java.nio.file.Files.exists(path(deleted.split('\t', 3)[2]), java.nio.file.LinkOption.NOFOLLOW_LINKS)
            assert !events.any { it.startsWith('ARTIFACT_MISSING\tOPTIONAL_SOURCE\t') }
        }
    }

    test("reclaims only declared outputs from a task with undeclared side files") {
        when {
            params {
                scenario = 'multi_output_side_files'
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            def tracked = events.findAll { it.startsWith('ARTIFACT_TRACKED\tMULTI_OUTPUT_SOURCE\t') }
            def deleted = events.findAll { it.startsWith('ARTIFACT_DELETED\tMULTI_OUTPUT_SOURCE\t') }
            assert tracked.size() == 2
            assert deleted.size() == 2
            assert (deleted.collect { path(it.split('\t', 3)[2]).fileName.toString() } as Set) == (['sample.bam', 'sample.bai'] as Set)

            def workDir = path(deleted.first().split('\t', 3)[2]).parent
            assert java.nio.file.Files.exists(workDir.resolve('align.log'))
            assert java.nio.file.Files.exists(workDir.resolve('scratch.tmp'))
            assert java.nio.file.Files.exists(workDir.resolve('.command.sh'))
            assert java.nio.file.Files.exists(workDir.resolve('.command.run'))
            assert !events.any { it.startsWith('ARTIFACT_TRACKED\tMULTI_OUTPUT_SOURCE\t') && (it.endsWith('/align.log') || it.endsWith('/scratch.tmp')) }
        }
    }

    test("reclaims a log when the log is a declared process output") {
        when {
            params {
                scenario = 'declared_log_output'
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            def tracked = events.findAll { it.startsWith('ARTIFACT_TRACKED\tDECLARED_LOG_SOURCE\t') }
            def deleted = events.findAll { it.startsWith('ARTIFACT_DELETED\tDECLARED_LOG_SOURCE\t') }
            assert tracked.size() == 2
            assert deleted.size() == 2
            assert (deleted.collect { path(it.split('\t', 3)[2]).fileName.toString() } as Set) == (['sample.bam', 'align.log'] as Set)
            deleted.each { event ->
                assert !java.nio.file.Files.exists(path(event.split('\t', 3)[2]), java.nio.file.LinkOption.NOFOLLOW_LINKS)
            }
        }
    }

    test("tracks all realized glob outputs without acquiring an undeclared side file") {
        when {
            params {
                scenario = 'glob_with_side_file'
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            def tracked = events.findAll { it.startsWith('ARTIFACT_TRACKED\tGLOB_WITH_SIDE_SOURCE\t') }
            def deleted = events.findAll { it.startsWith('ARTIFACT_DELETED\tGLOB_WITH_SIDE_SOURCE\t') }
            assert tracked.size() == 3
            assert deleted.size() == 3
            assert (deleted.collect { path(it.split('\t', 3)[2]).fileName.toString() } as Set) == (['one.bam', 'two.bam', 'three.bam'] as Set)

            def workDir = path(deleted.first().split('\t', 3)[2]).parent
            assert java.nio.file.Files.exists(workDir.resolve('tool.log'))
            assert !events.any { it.startsWith('ARTIFACT_TRACKED\tGLOB_WITH_SIDE_SOURCE\t') && it.endsWith('/tool.log') }
        }
    }

    test("tracks only path members of a tuple output") {
        when {
            params {
                scenario = 'tuple_outputs'
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            def tracked = events.findAll { it.startsWith('ARTIFACT_TRACKED\tTUPLE_SOURCE\t') }
            def deleted = events.findAll { it.startsWith('ARTIFACT_DELETED\tTUPLE_SOURCE\t') }
            assert tracked.size() == 2
            assert deleted.size() == 2
            assert (deleted.collect { path(it.split('\t', 3)[2]).fileName.toString() } as Set) == (['sample1.bam', 'sample1.bai'] as Set)
        }
