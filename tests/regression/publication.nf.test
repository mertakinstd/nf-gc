    test("retains an overlapping published tree while reclaiming an unrelated sibling") {
        when {
            params {
                scenario = 'overlapping_publish_tree'
                publish_dir = "$launchDir/overlapping-published"
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            def sourceComplete = events.find { line ->
                def f = line.split('\t', 5)
                f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'OVERLAPPING_PUBLISH_TREE'
            }
            assert sourceComplete != null

            def workDir = java.nio.file.Path.of(sourceComplete.split('\t', 5)[4])
            def bundle = workDir.resolve('bundle')
            def item = bundle.resolve('item.txt')
            def independent = workDir.resolve('independent.txt')

            assert java.nio.file.Files.exists(item, java.nio.file.LinkOption.NOFOLLOW_LINKS)
            assert !events.any { it == "ARTIFACT_DELETED\tOVERLAPPING_PUBLISH_TREE\t${bundle}" }
            assert !events.any { it == "ARTIFACT_DELETED\tOVERLAPPING_PUBLISH_TREE\t${item}" }
            assert events.any { it == "ARTIFACT_DELETED\tOVERLAPPING_PUBLISH_TREE\t${independent}" }
            assert !java.nio.file.Files.exists(independent, java.nio.file.LinkOption.NOFOLLOW_LINKS)
            assert path("$launchDir/overlapping-published/bundle/item.txt").exists()
            assert path("$launchDir/overlapping-published/bundle/extra.txt").exists()
        }
    }

    test("retains a declared symlink alias and its backing declared tree in artifact mode") {
        config "tests/config/gc_mode_artifact.config"

        when {
            params {
                scenario = 'symlink_alias_publish_tree'
                publish_dir = "$launchDir/symlink-alias-published"
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            def sourceComplete = events.find { line ->
                def f = line.split('\t', 5)
                f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'SYMLINK_ALIAS_PUBLISH_TREE'
            }
            assert sourceComplete != null

            def workDir = java.nio.file.Path.of(sourceComplete.split('\t', 5)[4])
            def linkdir = workDir.resolve('linkdir')
            def item = workDir.resolve('real/item.txt')
            def independent = workDir.resolve('independent.txt')

            assert java.nio.file.Files.isSymbolicLink(linkdir)
            assert java.nio.file.Files.exists(item, java.nio.file.LinkOption.NOFOLLOW_LINKS)
            assert !events.any { it == "ARTIFACT_DELETED\tSYMLINK_ALIAS_PUBLISH_TREE\t${linkdir}" }
            assert !events.any { it == "ARTIFACT_DELETED\tSYMLINK_ALIAS_PUBLISH_TREE\t${item}" }
            assert events.any { it == "ARTIFACT_DELETED\tSYMLINK_ALIAS_PUBLISH_TREE\t${independent}" }
            assert !java.nio.file.Files.exists(independent, java.nio.file.LinkOption.NOFOLLOW_LINKS)
            assert path("$launchDir/symlink-alias-published/linkdir/item.txt").exists()
            assert path("$launchDir/symlink-alias-published/linkdir/extra.txt").exists()
        }
    }


    test("retains an upstream backing artifact for a published symlink output in process mode") {
        when {
            params {
                scenario = 'symlink_backing_publish'
                publish_dir = "$launchDir/symlink-backing-published"
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            def sourceComplete = events.find { line ->
                def f = line.split('\t', 5)
                f.size() == 5 && f[0] == 'TASK_COMPLETE' && f[2] == 'SYMLINK_BACKING_SOURCE'
            }
            assert sourceComplete != null

            def sourceDir = java.nio.file.Path.of(sourceComplete.split('\t', 5)[4]).resolve('source-dir')
            assert java.nio.file.Files.exists(sourceDir.resolve('item.txt'), java.nio.file.LinkOption.NOFOLLOW_LINKS)
            assert !events.any { it == "ARTIFACT_DELETED\tSYMLINK_BACKING_SOURCE\t${sourceDir}" }
            assert path("$launchDir/symlink-backing-published/alias/item.txt").exists()
        }
    }

