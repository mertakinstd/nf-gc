nextflow_pipeline {

    name "nf-gc publication regression matrix"
    script "tests/regression/publication.nf"


    test("preserves an artifact published with copy mode") {
        when {
            params {
                scenario = 'publish_mode'
                publish_mode = 'copy'
                publish_dir = "$launchDir/mode-copy"
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            assert events.contains('ARTIFACT_KEEP\tPUBLISH_MODE\tPUBLISH_DIR')
            assert !events.any { it.startsWith('ARTIFACT_TRACKED\tPUBLISH_MODE\t') }
            assert !events.any { it.startsWith('ARTIFACT_DELETED\tPUBLISH_MODE\t') }
            def published = path("$launchDir/mode-copy/mode.txt")
            assert published.exists()
            assert published.text == 'copy\n'
        }
    }

