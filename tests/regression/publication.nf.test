    test("preserves an output selected by publishDir while it is consumed downstream") {
        when {
            params {
                scenario = 'publish_all'
                publish_dir = "$launchDir/published"
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            assert events.contains('ARTIFACT_KEEP\tPUBLISH_ALL\tPUBLISH_DIR')
            assert !events.any { it.startsWith('ARTIFACT_TRACKED\tPUBLISH_ALL\t') }
            assert !events.any { it.startsWith('ARTIFACT_DELETED\tPUBLISH_ALL\t') }
            assert path("$launchDir/published/result.txt").exists()
        }
    }

    test("reclaims an unpublished output while preserving a published sibling") {
        when {
            params {
                scenario = 'partial_publish'
                publish_dir = "$launchDir/published"
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            assert events.any {
                it.startsWith('ARTIFACT_TRACKED\tPARTIAL_PUBLISH\t') &&
                it.endsWith('sample.bam')
            }
            assert events.any {
                it.startsWith('ARTIFACT_DELETED\tPARTIAL_PUBLISH\t') &&
                it.endsWith('sample.bam')
            }
            assert !events.any {
                it.startsWith('ARTIFACT_DELETED\tPARTIAL_PUBLISH\t') &&
                it.endsWith('qc.log')
            }
            assert path("$launchDir/published/qc.log").exists()
            assert !path("$launchDir/published/sample.bam").exists()

            def workBams = []
            def workQcLogs = []
            java.nio.file.Files.walk(path(workDir)).withCloseable { stream ->
                stream.filter {
                    java.nio.file.Files.isRegularFile(it, java.nio.file.LinkOption.NOFOLLOW_LINKS)
                }.forEach {
                    if( it.fileName.toString() == 'sample.bam' )
                        workBams << it
                    else if( it.fileName.toString() == 'qc.log' )
                        workQcLogs << it
                }
            }

            assert workBams.isEmpty()
            assert workQcLogs.size() == 1
        }
    }

    test("reclaims a file rejected by an nf-core-style filename saveAs filter") {
        when {
            params {
                scenario = 'nfcore_default_saveas'
                publish_dir = "$launchDir/nfcore-default"
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            assert events.any {
                it.startsWith('ARTIFACT_TRACKED\tNFCORE_DEFAULT_PUBLISH\t') &&
                it.endsWith('versions.yml')
            }
            assert events.any {
                it.startsWith('ARTIFACT_DELETED\tNFCORE_DEFAULT_PUBLISH\t') &&
                it.endsWith('versions.yml')
            }
            assert !events.any {
                it.startsWith('ARTIFACT_DELETED\tNFCORE_DEFAULT_PUBLISH\t') &&
                it.endsWith('result.txt')
            }
            assert path("$launchDir/nfcore-default/result.txt").exists()
            assert !path("$launchDir/nfcore-default/versions.yml").exists()

            def workResults = []
            def workVersions = []
            java.nio.file.Files.walk(path(workDir)).withCloseable { stream ->
                stream.filter {
                    java.nio.file.Files.isRegularFile(it, java.nio.file.LinkOption.NOFOLLOW_LINKS)
                }.forEach {
                    if( it.fileName.toString() == 'result.txt' )
                        workResults << it
                    else if( it.fileName.toString() == 'versions.yml' )
                        workVersions << it
                }
            }
            assert workResults.size() == 1
            assert workVersions.isEmpty()
        }
    }

    test("reclaims an nf-core-style gated BAM when save_align_intermeds is false") {
        when {
            params {
                scenario = 'nfcore_star_saveas'
                publish_dir = "$launchDir/nfcore-star-disabled"
                save_align_intermeds = false
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            assert events.any {
                it.startsWith('ARTIFACT_TRACKED\tNFCORE_STAR_PUBLISH\t') &&
                it.endsWith('sample.bam')
            }
            assert events.any {
                it.startsWith('ARTIFACT_DELETED\tNFCORE_STAR_PUBLISH\t') &&
                it.endsWith('sample.bam')
            }
            assert !events.any {
                it.startsWith('ARTIFACT_DELETED\tNFCORE_STAR_PUBLISH\t') &&
                (it.endsWith('Log.final.out') || it.endsWith('SJ.out.tab'))
            }
            assert path("$launchDir/nfcore-star-disabled/Log.final.out").exists()
            assert path("$launchDir/nfcore-star-disabled/SJ.out.tab").exists()
            assert !path("$launchDir/nfcore-star-disabled/sample.bam").exists()

            def workBams = []
            def workLogs = []
            java.nio.file.Files.walk(path(workDir)).withCloseable { stream ->
                stream.filter {
                    java.nio.file.Files.isRegularFile(it, java.nio.file.LinkOption.NOFOLLOW_LINKS)
                }.forEach {
                    if( it.fileName.toString() == 'sample.bam' )
                        workBams << it
                    else if( it.fileName.toString() in ['Log.final.out', 'SJ.out.tab'] )
                        workLogs << it
                }
            }
            assert workBams.isEmpty()
            assert workLogs.size() == 2
        }
    }

    test("preserves an nf-core-style gated BAM when save_align_intermeds is true") {
        when {
            params {
                scenario = 'nfcore_star_saveas'
                publish_dir = "$launchDir/nfcore-star-enabled"
                save_align_intermeds = true
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            assert !events.any {
                it.startsWith('ARTIFACT_TRACKED\tNFCORE_STAR_PUBLISH\t') &&
                it.endsWith('sample.bam')
            }
            assert !events.any {
                it.startsWith('ARTIFACT_DELETED\tNFCORE_STAR_PUBLISH\t') &&
                it.endsWith('sample.bam')
            }
            assert path("$launchDir/nfcore-star-enabled/sample.bam").exists()
            assert path("$launchDir/nfcore-star-enabled/Log.final.out").exists()
            assert path("$launchDir/nfcore-star-enabled/SJ.out.tab").exists()

            def workBams = []
            java.nio.file.Files.walk(path(workDir)).withCloseable { stream ->
                stream.filter {
                    java.nio.file.Files.isRegularFile(it, java.nio.file.LinkOption.NOFOLLOW_LINKS)
                }.forEach {
                    if( it.fileName.toString() == 'sample.bam' )
                        workBams << it
                }
            }
            assert workBams.size() == 1
        }
    }

    test("preserves outputs selected by multiple publishDir directives") {
        when {
            params {
                scenario = 'multiple_publish'
                publish_dir = "$launchDir/published-one"
                publish_dir_2 = "$launchDir/published-two"
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            assert events.contains('ARTIFACT_KEEP\tMULTIPLE_PUBLISH\tPUBLISH_DIR')
            assert !events.any { it.startsWith('ARTIFACT_TRACKED\tMULTIPLE_PUBLISH\t') }
            assert path("$launchDir/published-one/one.txt").exists()
            assert path("$launchDir/published-two/two.txt").exists()
        }
    }

    test("freezes the runtime semantics of publishDir enabled false conservatively") {
        when {
            params {
                scenario = 'disabled_publish'
                publish_dir = "$launchDir/disabled-publish"
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            assert !path("$launchDir/disabled-publish/result.txt").exists()
            assert events.contains('ARTIFACT_KEEP\tDISABLED_PUBLISH\tPUBLISH_DIR')
            assert !events.any { it.startsWith('ARTIFACT_DELETED\tDISABLED_PUBLISH\t') }
        }
    }

    test("keeps storeDir outputs outside task work ownership") {
        when {
            params {
                scenario = 'store_dir'
                store_dir = "$launchDir/store"
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            assert events.contains('ARTIFACT_KEEP\tSTORE_SOURCE\tTARGET_DIR')
            assert !events.any { it.startsWith('ARTIFACT_TRACKED\tSTORE_SOURCE\t') }
            assert !events.any { it.startsWith('ARTIFACT_DELETED\tSTORE_SOURCE\t') }
            assert path("$launchDir/store/stored.txt").exists()
        }
    }

    test("keeps a terminal process without publishDir") {
        when {
            params {
                scenario = 'terminal'
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            assert events.contains('ARTIFACT_KEEP\tTERMINAL_SOURCE\tTERMINAL')
            assert !events.any { it.startsWith('ARTIFACT_DELETED\tTERMINAL_SOURCE\t') }
        }
    }

}
