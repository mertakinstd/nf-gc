    test("keeps relative-symlink publish mode under the binary publication policy") {
        when {
            params {
                scenario = 'publish_mode'
                publish_mode = 'rellink'
                publish_dir = "$launchDir/mode-rellink"
            }
        }
        then {
            assert workflow.success
            def events = path("$launchDir/nf-gc-events.tsv").readLines()
