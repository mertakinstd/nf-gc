nextflow_pipeline {

    name "nf-gc rnaseq-like topology"
    script "tests/rnaseq_topology.nf"

    test("handles shared index, fan-out, join and aggregation") {

        when {
            params {
                extra_qc = true
                publish_dir = "$launchDir/published"
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.failed().size() == 0
            assert workflow.trace.tasks().size() == 26

            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            assert events.count { it == 'GC_MODE\tprocess' } == 1

            def processes = [
                'BUILD_INDEX',
                'TRIM_READS',
                'ALIGN',
                'SORT',
                'ALIGN_QC',
                'QUANT',
                'FEATURE_COUNTS',
                'EXTRA_QC',
                'MERGE_COUNTS',
                'REPORT'
            ]

            processes.each { processName ->
                assert events.count { it == "PROCESS_CREATE\t${processName}" } == 1
                assert events.count { it == "PROCESS_TERMINATE\t${processName}" } == 1
            }

            def graphEdges = events
                .findAll { it.startsWith('GRAPH_EDGE\t') }
                .collect { it.substring('GRAPH_EDGE\t'.length()) }
                .toSet()

            assert graphEdges == [
                'BUILD_INDEX\tALIGN',
                'BUILD_INDEX\tQUANT',
                'TRIM_READS\tALIGN',
                'ALIGN\tSORT',
                'ALIGN\tALIGN_QC',
                'ALIGN\tQUANT',
                'SORT\tFEATURE_COUNTS',
                'SORT\tEXTRA_QC',
                'FEATURE_COUNTS\tMERGE_COUNTS',
                'QUANT\tMERGE_COUNTS',
                'MERGE_COUNTS\tREPORT',
                'ALIGN_QC\tREPORT',
                'EXTRA_QC\tREPORT'
            ].toSet()

            def terminated = { processName ->
                events.findIndexOf { it == "PROCESS_TERMINATE\t${processName}" }
            }
            def dependencyClosed = { processName ->
                events.findIndexOf { it == "DEPENDENCY_CLOSED\t${processName}" }
            }

            processes.each { processName ->
                assert events.count { it == "DEPENDENCY_CLOSED\t${processName}" } == 1
                assert dependencyClosed(processName) > terminated(processName)
            }

            graphEdges.each { edge ->
                def (producer, consumer) = edge.split('\t')
                assert dependencyClosed(producer) > terminated(consumer)
            }

            def trackedProcesses = events
                .findAll { it.startsWith('ARTIFACT_TRACKED\t') }
                .collect { it.split('\t')[1] }
                .toSet()
            def deletedProcesses = events
                .findAll { it.startsWith('ARTIFACT_DELETED\t') }
                .collect { it.split('\t')[1] }
                .toSet()

            assert trackedProcesses == [
                'BUILD_INDEX',
                'TRIM_READS',
                'ALIGN',
                'SORT',
                'QUANT',
                'FEATURE_COUNTS',
                'EXTRA_QC',
                'MERGE_COUNTS'
            ].toSet()
            assert deletedProcesses == trackedProcesses
            events.findAll { it.startsWith('ARTIFACT_DELETED\t') }.each { deletion ->
                def processName = deletion.split('\t')[1]
                assert events.findIndexOf { it == deletion } > dependencyClosed(processName)
            }
            assert events.contains('ARTIFACT_KEEP\tALIGN_QC\tPUBLISH_DIR')
            assert events.contains('ARTIFACT_KEEP\tREPORT\tTERMINAL')
            assert !events.any { it.startsWith('ARTIFACT_DELETE_FAILED\t') }
            assert !events.any { it.startsWith('ARTIFACT_MISSING\t') }
            assert path("$launchDir/published/sample1.align_qc.txt").exists()
            assert path("$launchDir/published/sample2.align_qc.txt").exists()
            assert path("$launchDir/published/sample3.align_qc.txt").exists()

            assert terminated('BUILD_INDEX') < terminated('ALIGN')
            assert terminated('BUILD_INDEX') < terminated('QUANT')
            assert terminated('ALIGN') < terminated('SORT')
            assert terminated('ALIGN') < terminated('ALIGN_QC')
            assert terminated('ALIGN') < terminated('QUANT')
            assert terminated('SORT') < terminated('FEATURE_COUNTS')
            assert terminated('SORT') < terminated('EXTRA_QC')
            assert terminated('FEATURE_COUNTS') < terminated('MERGE_COUNTS')
            assert terminated('QUANT') < terminated('MERGE_COUNTS')
            assert terminated('MERGE_COUNTS') < terminated('REPORT')
            assert terminated('ALIGN_QC') < terminated('REPORT')
            assert terminated('EXTRA_QC') < terminated('REPORT')

            assert events.first() == 'FLOW_CREATE'
            assert events.last() == 'FLOW_COMPLETE'
        }
    }

    test("handles an optional branch that is not instantiated") {

        when {
            params {
                extra_qc = false
                publish_dir = "$launchDir/published"
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.failed().size() == 0
            assert workflow.trace.tasks().size() == 23

            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            assert events.count { it == 'GC_MODE\tprocess' } == 1

            def graphEdges = events
                .findAll { it.startsWith('GRAPH_EDGE\t') }
                .collect { it.substring('GRAPH_EDGE\t'.length()) }
                .toSet()

            assert graphEdges == [
                'BUILD_INDEX\tALIGN',
                'BUILD_INDEX\tQUANT',
                'TRIM_READS\tALIGN',
                'ALIGN\tSORT',
                'ALIGN\tALIGN_QC',
                'ALIGN\tQUANT',
                'SORT\tFEATURE_COUNTS',
                'FEATURE_COUNTS\tMERGE_COUNTS',
                'QUANT\tMERGE_COUNTS',
                'MERGE_COUNTS\tREPORT',
                'ALIGN_QC\tREPORT'
            ].toSet()

            def processes = [
                'BUILD_INDEX',
                'TRIM_READS',
                'ALIGN',
                'SORT',
                'ALIGN_QC',
                'QUANT',
                'FEATURE_COUNTS',
                'MERGE_COUNTS',
                'REPORT'
            ]
            def terminated = { processName ->
                events.findIndexOf { it == "PROCESS_TERMINATE\t${processName}" }
            }
            def dependencyClosed = { processName ->
                events.findIndexOf { it == "DEPENDENCY_CLOSED\t${processName}" }
            }

            processes.each { processName ->
                assert events.count { it == "DEPENDENCY_CLOSED\t${processName}" } == 1
                assert dependencyClosed(processName) > terminated(processName)
            }

            graphEdges.each { edge ->
                def (producer, consumer) = edge.split('\t')
                assert dependencyClosed(producer) > terminated(consumer)
            }

            def trackedProcesses = events
                .findAll { it.startsWith('ARTIFACT_TRACKED\t') }
                .collect { it.split('\t')[1] }
                .toSet()
            def deletedProcesses = events
                .findAll { it.startsWith('ARTIFACT_DELETED\t') }
                .collect { it.split('\t')[1] }
                .toSet()

            assert trackedProcesses == [
                'BUILD_INDEX',
                'TRIM_READS',
                'ALIGN',
                'SORT',
                'QUANT',
                'FEATURE_COUNTS',
                'MERGE_COUNTS'
            ].toSet()
            assert deletedProcesses == trackedProcesses
            events.findAll { it.startsWith('ARTIFACT_DELETED\t') }.each { deletion ->
                def processName = deletion.split('\t')[1]
                assert events.findIndexOf { it == deletion } > dependencyClosed(processName)
            }
            assert events.contains('ARTIFACT_KEEP\tALIGN_QC\tPUBLISH_DIR')
            assert events.contains('ARTIFACT_KEEP\tREPORT\tTERMINAL')
            assert !events.any { it.startsWith('ARTIFACT_DELETE_FAILED\t') }
            assert !events.any { it.startsWith('ARTIFACT_MISSING\t') }
            assert path("$launchDir/published/sample1.align_qc.txt").exists()
            assert path("$launchDir/published/sample2.align_qc.txt").exists()
            assert path("$launchDir/published/sample3.align_qc.txt").exists()

            assert !events.contains('DEPENDENCY_CLOSED\tEXTRA_QC')
            assert !events.contains('PROCESS_CREATE\tEXTRA_QC')
            assert !events.contains('PROCESS_TERMINATE\tEXTRA_QC')
            assert events.contains('PROCESS_TERMINATE\tREPORT')
            assert events.last() == 'FLOW_COMPLETE'
        }
    }

    test("reclaims ALIGN output ports by their own consumer sets in artifact mode") {
        config "tests/config/gc_mode_artifact.config"

        when {
            params {
                extra_qc = false
                publish_dir = "$launchDir/published"
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.failed().size() == 0
            assert workflow.trace.tasks().size() == 23

            def events = path("$launchDir/nf-gc-events.tsv").readLines()
            assert events.count { it == 'GC_MODE\tartifact' } == 1

            def terminated = { processName ->
                events.findIndexOf { it == "PROCESS_TERMINATE\t${processName}" }
            }
            def sortTerminated = terminated('SORT')
            def alignQcTerminated = terminated('ALIGN_QC')
            def quantTerminated = terminated('QUANT')

            assert sortTerminated >= 0
            assert alignQcTerminated > sortTerminated
            assert quantTerminated > alignQcTerminated

            def alignTracked = events
                .findAll { it.startsWith('ARTIFACT_TRACKED\tALIGN\t') }
                .collect { tracked -> tracked.split('\t', 3)[2] }

            def genomeBams = alignTracked.findAll { artifact ->
                java.nio.file.Path.of(artifact).fileName.toString().endsWith('.genome.bam')
            }
            def transcriptBams = alignTracked.findAll { artifact ->
                java.nio.file.Path.of(artifact).fileName.toString().endsWith('.transcript.bam')
            }

            assert genomeBams.size() == 3
            assert transcriptBams.size() == 3

            genomeBams.each { artifact ->
                def deletion = "ARTIFACT_DELETED\tALIGN\t${artifact}"
                assert events.count { it == deletion } == 1
                def deleted = events.findIndexOf { it == deletion }

                // genome_bam is consumed by SORT and ALIGN_QC, but not QUANT.
                assert deleted > sortTerminated
                assert deleted > alignQcTerminated
                assert deleted < quantTerminated
                assert !java.nio.file.Files.exists(path(artifact), java.nio.file.LinkOption.NOFOLLOW_LINKS)
            }

            transcriptBams.each { artifact ->
                def deletion = "ARTIFACT_DELETED\tALIGN\t${artifact}"
                assert events.count { it == deletion } == 1
                def deleted = events.findIndexOf { it == deletion }

                // transcript_bam is consumed by QUANT and must survive until QUANT terminates.
                assert deleted > quantTerminated
                assert !java.nio.file.Files.exists(path(artifact), java.nio.file.LinkOption.NOFOLLOW_LINKS)
            }

            assert events.contains('ARTIFACT_KEEP\tALIGN_QC\tPUBLISH_DIR')
            assert path("$launchDir/published/sample1.align_qc.txt").exists()
            assert path("$launchDir/published/sample2.align_qc.txt").exists()
            assert path("$launchDir/published/sample3.align_qc.txt").exists()
            assert !events.any { it.startsWith('ARTIFACT_DELETE_FAILED\t') }
            assert !events.any { it.startsWith('ARTIFACT_MISSING\t') }
        }
    }

}
